name: Actualizar datos de calles
on:
  schedule:
    - cron: '0 6 * * 1'   # todos los lunes
  workflow_dispatch:       # y a mano desde la pestaña Actions
permissions:
  contents: write
jobs:
  actualizar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Descargar calles de OpenStreetMap
        run: python3 scripts/actualizar_datos.py
      - name: Guardar cambios
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add data/calles.json
          git diff --cached --quiet || (git commit -m "Actualizar datos de calles" && git push)
